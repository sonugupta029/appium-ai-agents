{
  "name": "appium-debug-helper",
  "description": "Analyzes Appium test logs and HTML reports to diagnose failures — identifies changed element IDs, stale locators, timing issues, and app changes — then proposes fixes to screen files for your approval.",
  "prompt": "file://../agent-prompts/appium-debug-helper/appium-debug-helper-prompt.md",
  "includeMcpJson": true,
  "tools": [
    "read",
    "glob",
    "grep",
    "write",
    "shell",
    "code",
    "todo",
    "introspect",
    "mcp",
    "@atlassian"
  ],
  "allowedTools": [
    "read",
    "glob",
    "grep",
    "code",
    "todo",
    "introspect"
  ],
  "toolsSettings": {
    "read": {
      "deniedPaths": [
        "**/.env",
        "**/.env.*",
        "**/*.pem",
        "**/*.key",
        "**/id_rsa*",
        "**/*credentials*",
        "~/.ssh/**",
        "~/.aws/**"
      ]
    },
    "write": {
      "deniedPaths": [
        ".git/**",
        ".kiro/**",
        "**/.env",
        "**/.env.*",
        "**/*.pem",
        "**/*.key",
        "**/project.properties"
      ]
    },
    "shell": {
      "allowedCommands": [
        "^git status$",
        "^git diff( --[a-z-]*)? [a-zA-Z0-9._/-]*$",
        "^git log( --[a-z-]*)? ?[a-zA-Z0-9._/-]*$",
        "^git show [a-zA-Z0-9._/-]*$",
        "^git grep [a-zA-Z0-9 _.-]+ -- [a-zA-Z0-9/_.*-]+$",
        "^ls( -[a-zA-Z]+)? [a-zA-Z0-9/_.*-]*$",
        "^find [a-zA-Z0-9/_.*-]+ -name [a-zA-Z0-9_.*-]+$"
      ],
      "deniedCommands": [
        "git commit.*",
        "git push.*",
        "git reset.*",
        "git clean.*",
        "rm.*",
        "mv.*",
        "cp.*",
        "chmod.*",
        "curl.*",
        "wget.*"
      ],
      "autoAllowReadonly": false
    }
  },
  "resources": [
    "file://README.md",
    "file://.kiro/steering/**/*.md",
    "file://src/main/kotlin/com/appium/screens/**/*.kt",
    "file://src/main/kotlin/com/appium/reusables/**/*.kt"
  ],
  "welcomeMessage": "Appium Debug Helper ready. Share the test report, log file path, or paste the error — I'll analyze the failure and propose a fix for your approval."
}
